{
  "permissions": {
    "allow": [
      "Bash(python fab.py *)",
      "PowerShell(python fab.py *)",
      "PowerShell(Start-Process -FilePath python *)",
      "PowerShell(Get-CimInstance Win32_Process*)",
      "PowerShell(Get-Process*)",
      "PowerShell(taskkill /PID * /T /F)",
      "PowerShell(Stop-Process -Id *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/nucleo/hook_contexto.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
