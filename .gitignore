# ---------------------------------------------------------------- SECRETOS (nunca subir)
canales/youtube_client_secrets.json
canales/tokens/
*client_secret*.json
*youtube_tokens*.json
.env

# datos privados del canal (métricas y respaldos quedan solo en esta PC)
canales/metricas/
canales/respaldos/

# ---------------------------------------------------------------- pesados / regenerables
# por video solo se versiona el código y la configuración: guion.py, escenas.py, miniaturas.py,
# youtube.json y timeline.json. Voz, audio, render, previews y logs se regeneran con fab.py.
videos/*/voz/
videos/*/audio/
videos/*/segmentos/
videos/*/salida/
videos/*/previews/
videos/*/*.txt
videos/*/tiempos_prueba.json
*.mp4
*.wav
*.mp3

# copia vieja del proyecto (1.1 GB) y modelos (viven en la caché de HuggingFace)
proyecto/
modelos/*
!modelos/bajar_t3.sh

# revisión intermedia del arte del canal
canales/arte/*_revision.jpg

# Python / sistema
__pycache__/
*.pyc
Thumbs.db
desktop.ini

# Avisos por voz del panel (caché de audio y configuración local)
panel_avisos/
panel_config.json
respaldos_pruebas/
voz_gpu.lock

# Estudio (versión comercial): nada de datos del usuario en git
estudio/ajustes.json
estudio/voces/
estudio/proyectos/
estudio/iconos/
estudio/estilos.json
estudio/servidor_log.txt
estudio/portadas/
estudio/vistas/

# medios de cada video (imágenes de Flow/Commons, clips, cuadros, datos pesados, sfx, muestras de voz):
# viven en esta PC (y en E:), no son motor; las fotos de Commons se vuelven a bajar con imagenes_web.py (creditos.json sí se versiona)
videos/*/clips/
videos/*/medios*/
videos/*/imagenes/
videos/*/retratos/
videos/*/fuentes/
videos/*/mapas/
videos/*/datos/
videos/*/boceto_v1/
videos/*/v2_lateral/
videos/*/sfx/
videos/*/muestras_voz/
videos/**/*.jpg
videos/**/*.jpeg
videos/**/*.png
videos/**/*.webp
videos/**/*.npz
videos/**/*.npy
videos/**/*.nc
videos/*/_*.log
*.bak_*

# logs
panel_log*.txt
videos/_*.txt
