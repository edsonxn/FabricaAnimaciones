{
 "frases": [
  {
   "t0": 0.0,
   "t1": 3.9,
   "texto": "Comer pez fugo en Japón es como jugar a la ruleta rusa en la mesa."
  },
  {
   "t0": 4.04,
   "t1": 6.6,
   "texto": "Este pez contiene tetrodotoxina."
  },
  {
   "t0": 6.68,
   "t1": 9.36,
   "texto": "Es un veneno mil veces más potente que el cianuro,"
  },
  {
   "t0": 9.5,
   "t1": 11.38,
   "texto": "para el cual no existe antídoto."
  },
  {
   "t0": 11.64,
   "t1": 14.78,
   "texto": "En los años 70, el legendario actor de teatro kabuki,"
  },
  {
   "t0": 14.98,
   "t1": 16.02,
   "texto": "Bando Mitsugoro,"
  },
  {
   "t0": 16.18,
   "t1": 19.06,
   "texto": "exigió que le sirvieran cuatro hígados de este pez,"
  },
  {
   "t0": 19.08,
   "t1": 20.6,
   "texto": "la parte más venenosa."
  },
  {
   "t0": 20.78,
   "t1": 22.5,
   "texto": "A pesar de las advertencias del chef,"
  },
  {
   "t0": 22.64,
   "t1": 24.38,
   "texto": "el cliente decidió consumirlos."
  },
  {
   "t0": 24.56,
   "t1": 25.84,
   "texto": "Apenas unas horas después,"
  },
  {
   "t0": 26.06,
   "t1": 29.44,
   "texto": "la parálisis llegó a sus pulmones y no volvió a respirar."
  },
  {
   "t0": 29.44,
   "t1": 30.58,
   "texto": "A raíz de este caso,"
  },
  {
   "t0": 30.66,
   "t1": 33.08,
   "texto": "las leyes en Japón se volvieron más estrictas."
  },
  {
   "t0": 33.18,
   "t1": 35.46,
   "texto": "Solo los chefs con licencias especiales,"
  },
  {
   "t0": 35.46,
   "t1": 36.9,
   "texto": "tras años de entrenamiento,"
  },
  {
   "t0": 36.98,
   "t1": 38.6,
   "texto": "pueden servir este platillo."
  },
  {
   "t0": 38.68,
   "t1": 39.96,
   "texto": "En la alta cocina,"
  },
  {
   "t0": 40.0,
   "t1": 43.22,
   "texto": "la diferencia entre un manjar y un platillo letal,"
  },
  {
   "t0": 43.24,
   "t1": 46.3,
   "texto": "lo define la precisión del cuchillo."
  }
 ],
