[
 {
  "id": "scene-001",
  "t0": 0.0,
  "t1": 3.39,
  "tipo": "imagen",
  "texto": "Hundreds of ladybugs on your house in October."
 },
 {
  "id": "scene-002",
  "t0": 3.39,
  "t1": 5.15,
  "tipo": "imagen",
  "texto": "A week later, they are"
 },
 {
  "id": "scene-003",
  "t0": 5.15,
  "t1": 7.951,
  "tipo": "imagen",
  "texto": "gone. So where did they go?"
 },
 {
  "id": "scene-004",
  "t0": 7.951,
  "t1": 10.111,
  "tipo": "imagen",
  "texto": "Into your walls. For the whole"
 },
 {
  "id": "scene-005",
  "t0": 10.111,
  "t1": 12.43,
  "tipo": "imagen",
  "texto": "winter."
 },
 {
  "id": "scene-006",
  "t0": 12.43,
  "t1": 15.67,
  "tipo": "imagen",
  "texto": "And they are probably not ladybugs. See the little"
 },
 {
  "id": "scene-007",
  "t0": 15.67,
  "t1": 19.213,
  "tipo": "imagen",
  "texto": "M on the head? That is an Asian lady beetle."
 },
 {
  "id": "scene-008",
  "t0": 19.213,
  "t1": 20.973,
  "tipo": "imagen",
  "texto": "To them, your sunny wall"
 },
 {
  "id": "scene-009",
  "t0": 20.973,
  "t1": 23.173,
  "tipo": "imagen",
  "texto": "looks like a cliff back home in Asia."
 },
 {
  "id": "scene-010",
  "t0": 23.173,
  "t1": 25.293,
  "tipo": "imagen",
  "texto": "So they move in, every single"
 },
 {
  "id": "scene-011",
  "t0": 25.293,
  "t1": 29.28,
  "tipo": "imagen",
  "texto": "year. They sleep all winter without eating."
 },
 {
  "id": "scene-012",
  "t0": 29.28,
  "t1": 31.44,
  "tipo": "imagen",
  "texto": "But a warm day fools them,"
 },
 {
  "id": "scene-013",
  "t0": 31.44,
  "t1": 34.565,
  "tipo": "imagen",
  "texto": "and out they come, onto your windows."
 },
 {
  "id": "scene-014",
  "t0": 34.565,
  "t1": 36.765,
  "tipo": "imagen",
  "texto": "Do not squish them. They bleed"
 },
 {
  "id": "scene-015",
  "t0": 36.765,
  "t1": 38.925,
  "tipo": "imagen",
  "texto": "a smelly yellow liquid from their"
 },
 {
  "id": "scene-016",
  "t0": 38.925,
  "t1": 41.842,
  "tipo": "imagen",
  "texto": "knees. Vacuum them up,"
 },
 {
  "id": "scene-017",
  "t0": 41.842,
  "t1": 44.712,
  "tipo": "imagen",
  "texto": "let them go outside in spring, and seal the"
 },
 {
  "id": "scene-018",
  "t0": 44.712,
  "t1": 47.25,
  "tipo": "imagen",
  "texto": "gaps before next October."
 }
