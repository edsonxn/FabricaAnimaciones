[
 {
  "id": "scene-001",
  "t0": 0.0,
  "t1": 3.786,
  "tipo": "imagen",
  "texto": "Haz una prueba ahora mismo. ¿Tus dientes se están tocando?"
 },
 {
  "id": "scene-002",
  "t0": 3.786,
  "t1": 6.966,
  "tipo": "imagen",
  "texto": "¿Tus hombros están cerca de tus orejas?"
 },
 {
  "id": "scene-003",
  "t0": 6.966,
  "t1": 9.126,
  "tipo": "imagen",
  "texto": "Si dijiste que sí, no eres el"
 },
 {
  "id": "scene-004",
  "t0": 9.126,
  "t1": 12.59,
  "tipo": "imagen",
  "texto": "único. Mucha gente aprieta los dientes"
 },
 {
  "id": "scene-005",
  "t0": 12.59,
  "t1": 15.31,
  "tipo": "imagen",
  "texto": "de día sin darse cuenta, frente a la pantalla,"
 },
 {
  "id": "scene-006",
  "t0": 15.31,
  "t1": 18.291,
  "tipo": "imagen",
  "texto": "en el tráfico, leyendo un mensaje."
 },
 {
  "id": "scene-007",
  "t0": 18.291,
  "t1": 21.931,
  "tipo": "imagen",
  "texto": "Esa tensión sube por las sienes y la nuca. Y se vuelve"
 },
 {
  "id": "scene-008",
  "t0": 21.931,
  "t1": 24.911,
  "tipo": "imagen",
  "texto": "el dolor de cabeza más común del mundo: el de tipo"
 },
 {
  "id": "scene-009",
  "t0": 24.911,
  "t1": 28.017,
  "tipo": "imagen",
  "texto": "tensional. El arreglo:"
 },
 {
  "id": "scene-010",
  "t0": 28.017,
  "t1": 30.737,
  "tipo": "imagen",
  "texto": "aprende la posición de descanso de tu quijada."
 },
 {
  "id": "scene-011",
  "t0": 30.737,
  "t1": 34.347,
  "tipo": "imagen",
  "texto": "Labios juntos, dientes separados, y la lengua tocando"
 },
 {
  "id": "scene-012",
  "t0": 34.347,
  "t1": 37.671,
  "tipo": "imagen",
  "texto": "suavemente el paladar. Los dientes solo deberían"
 },
 {
  "id": "scene-013",
  "t0": 37.671,
  "t1": 40.911,
  "tipo": "imagen",
  "texto": "tocarse para masticar y tragar. El resto del día,"
 },
 {
  "id": "scene-014",
  "t0": 40.911,
  "t1": 42.875,
  "tipo": "imagen",
  "texto": "deberían estar separados."
 },
 {
  "id": "scene-015",
  "t0": 42.875,
  "t1": 47.125,
  "tipo": "imagen",
  "texto": "Pega una nota pequeña en tu monitor o en el espejo. Cada vez que la veas,"
 },
 {
  "id": "scene-016",
  "t0": 47.125,
  "t1": 49.355,
  "tipo": "imagen",
  "texto": "revisa: ¿dientes separados?"
 },
 {
  "id": "scene-017",
  "t0": 49.355,
  "t1": 53.33,
  "tipo": "imagen",
  "texto": "¿hombros abajo? Y la quijada es solo uno de"
 },
 {
  "id": "scene-018",
  "t0": 53.33,
  "t1": 55.68,
  "tipo": "imagen",
  "texto": "los cinco lugares donde se esconde el estrés."
 },
 {
  "id": "scene-019",
  "t0": 55.68,
  "t1": 59.625,
  "tipo": "imagen",
  "texto": "El recorrido completo está en el video."
 }
]