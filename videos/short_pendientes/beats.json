[
 {
  "id": "scene-001",
  "t0": 0.0,
  "t1": 3.21,
  "tipo": "imagen",
  "texto": "¿Apagas la luz… y tu cabeza se enciende"
 },
 {
  "id": "scene-002",
  "t0": 3.21,
  "t1": 6.216,
  "tipo": "imagen",
  "texto": "con todos tus pendientes?"
 },
 {
  "id": "scene-003",
  "t0": 6.216,
  "t1": 9.136,
  "tipo": "imagen",
  "texto": "En 1927, la psicóloga Bluma"
 },
 {
  "id": "scene-004",
  "t0": 9.136,
  "t1": 12.536,
  "tipo": "imagen",
  "texto": "Zeigarnik notó que recordamos mejor las tareas interrumpidas"
 },
 {
  "id": "scene-005",
  "t0": 12.536,
  "t1": 15.848,
  "tipo": "imagen",
  "texto": "que las terminadas. De día, el ruido las tapa."
 },
 {
  "id": "scene-006",
  "t0": 15.848,
  "t1": 18.758,
  "tipo": "imagen",
  "texto": "En el silencio de la noche, el cerebro abre"
 },
 {
  "id": "scene-007",
  "t0": 18.758,
  "t1": 22.93,
  "tipo": "imagen",
  "texto": "todas las pestañas pendientes para no olvidarlas."
 },
 {
  "id": "scene-008",
  "t0": 22.93,
  "t1": 24.93,
  "tipo": "imagen",
  "texto": "El truco toma 5 minutos:"
 },
 {
  "id": "scene-009",
  "t0": 24.93,
  "t1": 27.305,
  "tipo": "imagen",
  "texto": "saca los pendientes de tu cabeza."
 },
 {
  "id": "scene-010",
  "t0": 27.305,
  "t1": 31.255,
  "tipo": "imagen",
  "texto": "Antes de acostarte, escribe en papel todo lo que tienes que hacer mañana."
 },
 {
  "id": "scene-011",
  "t0": 31.255,
  "t1": 33.83,
  "tipo": "imagen",
  "texto": "Con detalle. En 2018,"
 },
 {
  "id": "scene-012",
  "t0": 33.83,
  "t1": 37.211,
  "tipo": "imagen",
  "texto": "en la Universidad de Baylor, un grupo escribió su lista de"
 },
 {
  "id": "scene-013",
  "t0": 37.211,
  "t1": 40.159,
  "tipo": "imagen",
  "texto": "pendientes 5 minutos antes de dormir."
 },
 {
  "id": "scene-014",
  "t0": 40.159,
  "t1": 43.719,
  "tipo": "imagen",
  "texto": "Se durmieron unos 9 minutos más rápido que quienes anotaron"
 },
 {
  "id": "scene-015",
  "t0": 43.719,
  "t1": 47.129,
  "tipo": "imagen",
  "texto": "lo que ya habían terminado. Y entre más detallada la lista,"
 },
 {
  "id": "scene-016",
  "t0": 47.129,
  "t1": 49.947,
  "tipo": "imagen",
  "texto": "mejor. Al cerebro le basta con saber que"
 },
 {
  "id": "scene-017",
  "t0": 49.947,
  "t1": 52.865,
  "tipo": "imagen",
  "texto": "la pestaña quedó guardada."
 },
 {
  "id": "scene-018",
  "t0": 52.865,
  "t1": 56.285,
  "tipo": "imagen",
  "texto": "Y hay cuatro trucos más para apagar la mente de noche."
 },
 {
  "id": "scene-019",
  "t0": 56.285,
  "t1": 59.25,
  "tipo": "imagen",
  "texto": "Están en el video completo."
 }
]