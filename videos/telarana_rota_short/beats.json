[
 {
  "id": "scene-001",
  "t0": 0.0,
  "t1": 2.48,
  "tipo": "imagen",
  "texto": "You sweep away a spider web on your porch."
 },
 {
  "id": "scene-002",
  "t0": 2.48,
  "t1": 5.12,
  "tipo": "imagen",
  "texto": "The next morning, it is back. Same spot."
 },
 {
  "id": "scene-003",
  "t0": 5.12,
  "t1": 7.93,
  "tipo": "imagen",
  "texto": "How?"
 },
 {
  "id": "scene-004",
  "t0": 7.93,
  "t1": 10.51,
  "tipo": "imagen",
  "texto": "The spider dropped on a safety line of silk,"
 },
 {
  "id": "scene-005",
  "t0": 10.51,
  "t1": 12.63,
  "tipo": "imagen",
  "texto": "hid, and waited for you to go"
 },
 {
  "id": "scene-006",
  "t0": 12.63,
  "t1": 15.378,
  "tipo": "imagen",
  "texto": "inside."
 },
 {
  "id": "scene-007",
  "t0": 15.378,
  "t1": 17.698,
  "tipo": "imagen",
  "texto": "Then it rebuilt. Around sixty-five"
 },
 {
  "id": "scene-008",
  "t0": 17.698,
  "t1": 20.105,
  "tipo": "imagen",
  "texto": "feet of silk, overnight."
 },
 {
  "id": "scene-009",
  "t0": 20.105,
  "t1": 23.085,
  "tipo": "imagen",
  "texto": "And it recycles. Spiders eat their old webs,"
 },
 {
  "id": "scene-010",
  "t0": 23.085,
  "t1": 25.305,
  "tipo": "imagen",
  "texto": "and reuse some of that protein to spin"
 },
 {
  "id": "scene-011",
  "t0": 25.305,
  "t1": 27.357,
  "tipo": "imagen",
  "texto": "new silk."
 },
 {
  "id": "scene-012",
  "t0": 27.357,
  "t1": 30.557,
  "tipo": "imagen",
  "texto": "Sweep it every day, and it will move. Or swap your"
 },
 {
  "id": "scene-013",
  "t0": 30.557,
  "t1": 33.197,
  "tipo": "imagen",
  "texto": "porch light for a yellow bulb, and fewer bugs"
 },
 {
  "id": "scene-014",
  "t0": 33.197,
  "t1": 35.625,
  "tipo": "imagen",
  "texto": "means fewer webs."
 }
]